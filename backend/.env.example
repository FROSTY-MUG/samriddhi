# ========================================================
# SamriddhiAI Backend Environment Variables (.env.example)
# ========================================================

# Supabase / PostgreSQL Credentials
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_KEY=your-supabase-anon-or-service-role-key

# Direct Async PostgreSQL Connection String (PostGIS enabled)
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/samriddhiai

# Redis Cache & Rate Limiting URL (SlowAPI)
REDIS_URL=redis://localhost:6379/0

# JWT Secret for Session Authentication
JWT_SECRET=samriddhiai-super-secret-key-change-in-prod-sih2026

# Meta WhatsApp Cloud API (Graph API v17.0+)
META_WA_PHONE_NUMBER_ID=100654321098765
META_WA_ACCESS_TOKEN=your_meta_wa_access_token
META_WA_VERIFY_TOKEN=samriddhi_meta_verify_token_2026
META_WA_API_VERSION=v17.0

# CORS & Server Environment
FRONTEND_URL=https://samriddhi.vercel.app
APP_ENV=production
PORT=8000
