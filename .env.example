# ========================================================
# SamriddhiAI Frontend Environment Variables (.env.example)
# ========================================================

# Gemini API Key (for Voice Synthesis & Intent Parsing)
VITE_GEMINI_API_KEY=your_gemini_api_key

# Groq / Grok / OpenRouter Fallback Keys (Optional)
VITE_GROQ_API_KEY=your_groq_api_key
VITE_GROK_API_KEY=your_grok_api_key
VITE_OPENROUTER_API_KEY=your_openrouter_api_key

# Backend Core API URL (FastAPI)
# In development: http://localhost:8000
# In production on Render: https://samriddhiai-backend.onrender.com
VITE_API_URL=http://localhost:8000

# Supabase Cloud Configuration
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key-here
